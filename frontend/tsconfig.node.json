{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "paths": {"@/*": ["./src/*"]}
  },
  "include": [
    "*.config.ts",
    "tests/**/*.ts"
  ]
}
