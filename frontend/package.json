{
  "name": "english-hero-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "element-plus": "2.14.7",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.13"
  }
}
